NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://fhdod_runtime:change-me@localhost:5432/fhdod?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://fhdod_migrator:change-me@localhost:5432/fhdod?sslmode=disable
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
PUBLIC_SUBMISSION_RATE_LIMIT_MAX=10
PUBLIC_SUBMISSION_MAX_FIELDS=30
PUBLIC_SUBMISSION_MAX_TEXT_LENGTH=4000
LOG_LEVEL=info
# Set only for the controlled administrator provisioning command; do not commit credentials.
ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_PASSWORD=
